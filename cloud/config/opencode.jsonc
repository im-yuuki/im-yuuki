{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-background-agents@latest", "opencode-pty@latest"],
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp@latest"],
      "enabled": true,
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": true,
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true,
    },
  },
  "lsp": true,
  "permission": {
    "*": "allow",
    "bash": {
      "*": "allow",
      "brew *": "ask",
      "pkg *": "ask",
      "dd *": "ask",
      "chmod *": "ask",
      "chown *": "deny",
      "fdisk *": "deny",
      "format *": "deny",
      "mkfs *": "deny",
      "parted *": "deny",
      "reboot": "deny",
      "shutdown": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "sudo *": "deny",
    },
    "doom_loop": "ask",
    "external_directory": "ask",
  },
  "provider": {
    "agentrouter": {
      "name": "AgentRouter",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://agentrouter.org/v1",
      },
      "models": {
        "claude-opus-4-8": {
          "name": "Claude Opus 4.8",
          "status": "deprecated",
          "attachment": true,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "limit": {
            "context": 500000,
            "output": 500000,
          },
        },
        "claude-opus-5": {
          "name": "Claude Opus 5",
          "attachment": true,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "limit": {
            "context": 500000,
            "output": 500000,
          },
        },
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "attachment": true,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "limit": {
            "context": 500000,
            "output": 500000,
          },
        },
      },
    },
  },
  "tools": {
    "websearch": true,
    "codesearch": true,
  },
}
